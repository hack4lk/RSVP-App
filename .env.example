# Railway assigns PORT automatically; 3000 is handy for local development.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cruise_rsvp
# Keep this false for local PostgreSQL. Railway enables SSL automatically.
DB_SSL=false

# Protect the RSVP dashboard. Use a strong, unique password in Railway.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploying

# Customize the event without changing code. URL values should be publicly reachable.
EVENT_TITLE=Sunday Sunset Cruise
EVENT_DATE=Sunday, October 18 · 10:00 AM
EVENT_DESCRIPTION=Bring your favorite ride for a relaxed morning cruise, good coffee, and great company. All makes and models are welcome.
EVENT_IMAGE=https://images.unsplash.com/photo-1504215680853-026ed2a45def?auto=format&fit=crop&w=1800&q=85
LOCATION_NAME=Riverside Coffee House
MAP_DESCRIPTION=Coffee, check-in, and the cruise line-up start here.
LOCATION_IMAGE=https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1200&q=85
GOOGLE_MAPS_URL=https://maps.google.com/?q=Riverside+Coffee+House

# Cruise route shown on the public page
START_NAME=Cruise start
START_ADDRESS=123 Main Street, Your City
START_MAPS_URL=https://maps.google.com/?q=123+Main+Street,+Your+City
DESTINATION_NAME=Cruise destination
DESTINATION_ADDRESS=456 Scenic Drive, Your City
DESTINATION_MAPS_URL=https://maps.google.com/?q=456+Scenic+Drive,+Your+City
